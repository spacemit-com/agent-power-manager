classDiagram
    note for ConfigRepository "无状态清单接口：每次调用内部完成读取或原子读改写"
    class ConfigRepository {
        <<interface>>
        +List(AgentID) (PowerGroups, error)
        +Find(AgentID, PowerType, name) (PowerRef, bool, error)
        +Set(AgentID, PowerRef) error
        +Remove(AgentID, PowerType, name) error
    }

    note for PowerGroups "跨组件共享的三类 Power 分组；每个 key 对应一组版本已确定的 PowerRef"
    class PowerGroups {
        +skill []PowerRef
        +plugin []PowerRef
        +mcp []PowerRef
    }

    note for PowerRef "内存中包含 Type、Name、Version；磁盘组内只写 Name、Version"
    class PowerRef {
        +Type PowerType
        +Name string
        +Version string
    }

    note for jsonRepository "不保存跨调用状态；Set/Remove 在外层全局锁内完成单次原子读改写"
    class jsonRepository {
        +List(AgentID) (PowerGroups, error)
        +Find(AgentID, PowerType, name) (PowerRef, bool, error)
        +Set(AgentID, PowerRef) error
        +Remove(AgentID, PowerType, name) error
    }

    jsonRepository ..|> ConfigRepository
    ConfigRepository --> PowerGroups : lists
    PowerGroups --> PowerRef : groups
