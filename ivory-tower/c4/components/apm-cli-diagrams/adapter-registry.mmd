classDiagram
    note for AdapterRegistry "仅解析 Skill；RefreshInstalled 按 Agent ID 字典序探测并返回同序快照（ADR-004）"
    class AdapterRegistry {
        <<interface>>
        +Resolve(AgentID, PowerType) (Adapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }
    note for Adapter "Install 根据 PowerRef 从 stagingRoot 定位自身叶子内容；完成适配、原子发布和 staging 清理"
    class Adapter {
        <<interface>>
        +DetectAgent() (bool, error)
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot string) (InstallResult, error)
    }
    class AgentSnapshot {
        +Agents []AgentID
        +Contains(AgentID) bool
        +Ordered() []AgentID
    }
    class adapterRegistry {
        +Resolve(AgentID, PowerType) (Adapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }
    class skillAdapter {
        +DetectAgent() (bool, error)
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot string) (InstallResult, error)
    }
    class codexConfig {
        <<agentConfig>>
        id = codex
    }
    class claudeCodeConfig {
        <<agentConfig>>
        id = claude-code
    }
    class hermesConfig {
        <<agentConfig>>
        id = hermes-agent
    }

    adapterRegistry ..|> AdapterRegistry
    adapterRegistry --> skillAdapter : resolves by AgentID
    AdapterRegistry --> AgentSnapshot : refreshes in lexical order
    skillAdapter ..|> Adapter
    codexConfig --> skillAdapter : configures
    claudeCodeConfig --> skillAdapter : configures
    hermesConfig --> skillAdapter : configures
