classDiagram
    note for AdapterRegistry "按 Agent 分别解析 Skill/MCP/Plugin；RefreshInstalled 只检查 profile 根，不执行能力 CLI（ADR-004/010/014）"
    class AdapterRegistry {
        <<interface>>
        +ResolveSkill(AgentID) (Adapter, error)
        +ResolveMCP(AgentID) (MCPAdapter, error)
        +ResolvePlugin(AgentID) (PluginAdapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }
    class Adapter {
        <<interface>>
        +DetectAgent() (bool, error)
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot) (InstallResult, error)
    }
    note for MCPAdapter "只通过目标 Agent CLI；Inspect 不清晰即失败；Add/Remove 返回 applied/not-applied/unknown"
    class MCPAdapter {
        <<interface>>
        +Inspect(Context, name) (MCPPresence, error)
        +Add(Context, PowerRef, MCPServer) (MCPMutationResult, error)
        +Remove(Context, PowerRef) (MCPMutationResult, error)
    }
    class Registry
    class PluginAdapter {
        <<interface>>
        +DeploymentMode() PluginDeploymentMode
        +Inspect(Context, name) (PluginFact, error)
        +Add(Context, PluginTarget) (PluginMutationResult, error)
        +Remove(Context, PluginTarget) (PluginMutationResult, error)
        +TargetPath(name) (string, error)
    }
    note for MarketplacePluginAdapter "Codex/Claude 的组合接口；本地 marketplace source 必须是绝对 clean artifact 路径"
    class MarketplacePluginAdapter {
        <<interface>>
        +InspectMarketplace(Context, name) (MarketplaceFact, error)
        +RegisterMarketplace(Context, MarketplaceTarget) (PluginMutationResult, error)
        +UnregisterMarketplace(Context, MarketplaceTarget) (PluginMutationResult, error)
    }
    class skillAdapter
    class bibitMCPAdapter
    class codexMCPAdapter
    class claudeMCPAdapter
    class hermesMCPAdapter
    class bibitPluginAdapter
    class codexPluginAdapter
    class claudePluginAdapter
    class hermesPluginAdapter
    class AgentSnapshot

    Registry ..|> AdapterRegistry
    Registry --> skillAdapter : ResolveSkill
    Registry --> bibitMCPAdapter : ResolveMCP(bibit)
    Registry --> codexMCPAdapter : ResolveMCP(codex)
    Registry --> claudeMCPAdapter : ResolveMCP(claude-code user scope)
    Registry --> hermesMCPAdapter : ResolveMCP(hermes-agent)
    Registry --> PluginAdapter : ResolvePlugin(bibit/codex/claude/hermes)
    skillAdapter ..|> Adapter
    codexMCPAdapter ..|> MCPAdapter
    claudeMCPAdapter ..|> MCPAdapter
    hermesMCPAdapter ..|> MCPAdapter
    MarketplacePluginAdapter --|> PluginAdapter
    codexPluginAdapter ..|> MarketplacePluginAdapter
    claudePluginAdapter ..|> MarketplacePluginAdapter
    hermesPluginAdapter ..|> PluginAdapter
    AdapterRegistry --> AgentSnapshot : lexical snapshot
    note for bibitPluginAdapter "BIANBU_AGENT_HOME（默认 ~/.bianbu-agent）；plugins/<name> 目录即状态，Add/Remove 不调用 Plugin CLI（ADR-014）"
    bibitMCPAdapter ..|> MCPAdapter
    bibitPluginAdapter ..|> PluginAdapter
