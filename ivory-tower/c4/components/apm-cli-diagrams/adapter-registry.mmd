classDiagram
    note for AdapterRegistry "仅解析 Skill；刷新当前命令中已支持且已安装的 Agent 快照"
    class AdapterRegistry {
        <<interface>>
        +Resolve(AgentID, PowerType) (Adapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }

    note for Adapter "安装检测仅检查 Agent 根目录存在且为目录；Adapter 在 Install 后负责清理 stagingRoot"
    class Adapter {
        <<interface>>
        +DetectAgent() (bool, error)
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot string) error
    }

    note for AgentSnapshot "当前命令内不可变且不持久化的已支持且已安装 Agent 列表"
    class AgentSnapshot {
        +Agents []AgentID
        +Contains(AgentID) bool
        +Ordered() []AgentID
    }

    note for adapterRegistry "按 builtInAgentConfigs 的稳定顺序注册。Resolve 不要求已安装；Refresh 遇到检测错误立即返回零快照"
    class adapterRegistry {
        +Resolve(AgentID, PowerType) (Adapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }

    class skillAdapter {
        +DetectAgent() (bool, error)
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot string) error
    }

    class codexConfig {
        <<agentConfig>>
        id = codex
    }
    class claudeCodeConfig {
        <<agentConfig>>
        id = claude-code
    }
    class hermesConfig {
        <<agentConfig>>
        id = hermes-agent
    }

    adapterRegistry ..|> AdapterRegistry
    adapterRegistry --> skillAdapter : resolves by AgentID
    AdapterRegistry --> AgentSnapshot : refreshes
    skillAdapter ..|> Adapter
    codexConfig --> skillAdapter : configures
    claudeCodeConfig --> skillAdapter : configures
    hermesConfig --> skillAdapter : configures
