classDiagram
    note for AdapterRegistry "按 Agent 分别解析 Skill/MCP；RefreshInstalled 只检查 Agent 根，不执行 MCP CLI（ADR-004/010）"
    class AdapterRegistry {
        <<interface>>
        +ResolveSkill(AgentID) (Adapter, error)
        +ResolveMCP(AgentID) (MCPAdapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }
    class Adapter {
        <<interface>>
        +DetectAgent() (bool, error)
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot) (InstallResult, error)
    }
    note for MCPAdapter "只通过目标 Agent CLI；Inspect 不清晰即失败；Add/Remove 返回 applied/not-applied/unknown"
    class MCPAdapter {
        <<interface>>
        +Inspect(Context, name) (MCPPresence, error)
        +Add(Context, PowerRef, MCPServer) (MCPMutationResult, error)
        +Remove(Context, PowerRef) (MCPMutationResult, error)
    }
    class Registry
    class skillAdapter
    class codexMCPAdapter
    class claudeMCPAdapter
    class hermesMCPAdapter
    class AgentSnapshot

    Registry ..|> AdapterRegistry
    Registry --> skillAdapter : ResolveSkill
    Registry --> codexMCPAdapter : ResolveMCP(codex)
    Registry --> claudeMCPAdapter : ResolveMCP(claude-code user scope)
    Registry --> hermesMCPAdapter : ResolveMCP(hermes-agent)
    skillAdapter ..|> Adapter
    codexMCPAdapter ..|> MCPAdapter
    claudeMCPAdapter ..|> MCPAdapter
    hermesMCPAdapter ..|> MCPAdapter
    AdapterRegistry --> AgentSnapshot : lexical snapshot
