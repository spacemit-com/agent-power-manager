classDiagram
    note for PowerCache "版本化缓存接口：Fetch 清理 staging，并将版本已确定的 PowerRef 物化为无版本层目录"
    class PowerCache {
        <<interface>>
        +Fetch(PowerRef) (Content, error)
    }

    note for Content "已物化的 staging 内容位置"
    class Content {
        +Path string
    }

    note for FilesystemCache "按 type/name/version 读取缓存；经状态根内临时目录原子发布干净 staging"
    class FilesystemCache {
        +Fetch(PowerRef) (Content, error)
    }

    FilesystemCache ..|> PowerCache
    PowerCache --> PowerRef
    PowerCache --> Content : returns
