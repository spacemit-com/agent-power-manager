classDiagram
    note for PowerCache "只服务 Skill 的版本化 Cache/Staging；MCP 与所有 Plugin 均不使用此接口"
    class PowerCache {
        <<interface>>
        +Fetch(PowerRef) (stagingRoot string, error)
    }

    note for FilesystemCache "按 type/name/version 读取缓存；把叶子复制到 staging/<type-directory>/<name>，返回 staging 根"
    class FilesystemCache {
        +Fetch(PowerRef) (stagingRoot string, error)
    }

    FilesystemCache ..|> PowerCache
    PowerCache --> PowerRef : consumes

    note for PluginArtifactCache "Plugin Resource 独占 agent-aware immutable artifact：cache/plugins/<agent>/<logical-name>/<version>；Codex/Claude 其中生成单条目本地 marketplace，Hermes 从其中 staging"
    class PluginArtifactCache {
        +artifactRoot(AgentID, PowerRef) string
    }
