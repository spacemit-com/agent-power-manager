classDiagram
    note for Flags "install 解析 <power>[=<version>]；search 必须提供 Keyword；list 使用 Installed"
    class Flags {
        +Agent string
        +Type string
        +Name string
        +Version string
        +Keyword string
        +Installed bool
    }

    class ListResult {
        +CloudPowers []PowerRef
        +InstalledByAgent map~AgentID, []InstalledPower~
        +Failures map~AgentID, error~
    }

    note for CLIEntry "cobra 命令树根：注册 search/list/install/uninstall 子命令并路由"
    class CLIEntry {
        +Execute(args []string) error
    }

    note for Lifecycle "生命周期用例接口，CLI 入口的唯一下游依赖"
    class Lifecycle {
        <<interface>>
        +Search(Flags) ([]PowerRef, error)
        +Install(Flags) (Result, error)
        +Uninstall(Flags) (Result, error)
        +List(Flags) (ListResult, error)
    }

    CLIEntry --> Flags : parses
    CLIEntry --> Lifecycle : invokes
    Lifecycle --> ListResult : returns
