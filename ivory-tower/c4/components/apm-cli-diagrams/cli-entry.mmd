classDiagram
    note for Flags "search 只解析 Keyword 和可选 Type；install 解析 <power>[=<version>]；list 使用 Installed"
    class Flags {
        +Agent string
        +Type string
        +Name string
        +Version string
        +Keyword string
        +Installed bool
    }

    class SearchResult {
        +Powers []PowerRef
    }

    note for CLIEntry "cobra 命令树根：注册 search/list/install/uninstall 子命令并路由"
    class CLIEntry {
        +Execute(args []string) error
        +renderSearch(writer, SearchResult) error
    }

    note for SearchLifecycle "search 命令专属生命周期端口，是 CLI 入口的唯一下游业务依赖"
    class SearchLifecycle {
        <<interface>>
        +Search(Context, Flags) (SearchResult, error)
    }

    CLIEntry --> Flags : parses
    CLIEntry --> SearchLifecycle : invokes Search
    SearchLifecycle --> SearchResult : returns
    CLIEntry --> SearchResult : renders stdout
