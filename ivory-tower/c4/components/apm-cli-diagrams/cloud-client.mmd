classDiagram
    note for CloudClient "云端客户端接口：List 搜索资源列表，Get 取单个 Power 元数据"
    class CloudClient {
        <<interface>>
        +List(Query) ([]PowerRef, error)
        +Get(PowerRef) (PowerMeta, error)
    }

    note for PowerRef "Power 标识：名称 + 类别（skill/plugin/mcp），全局共享的引用类型"
    class PowerRef {
        +Name string
        +Type PowerType
    }

    note for PowerMeta "云端元数据：版本与下载地址，--type 缺省时据此推断类别"
    class PowerMeta {
        +Ref PowerRef
        +Version string
        +DownloadURL string
    }

    note for httpCloudClient "net/http 实现：HTTPS 调用云端 list/get 接口"
    class httpCloudClient {
        +List(Query) ([]PowerRef, error)
        +Get(PowerRef) (PowerMeta, error)
    }

    httpCloudClient ..|> CloudClient
    CloudClient --> PowerRef
    CloudClient --> PowerMeta
