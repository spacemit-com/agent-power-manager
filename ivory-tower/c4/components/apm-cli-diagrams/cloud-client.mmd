classDiagram
    note for CloudClient "Cloud 接口：List 返回带版本的全部 PowerRef；Get 将版本已确定的 PowerRef 原子写入缓存"
    class CloudClient {
        <<interface>>
        +List() ([]PowerRef, error)
        +Get(PowerRef) error
    }

    note for PowerRef "Power 引用：类别 + 名称 + 版本；Get/Fetch 前版本必须已确定"
    class PowerRef {
        +Name string
        +Type PowerType
        +Version string
    }

    note for LocalClient "开发期本地实现：扫描绝对路径资源根，Get 经缓存根内临时目录原子发布"
    class LocalClient {
        +List() ([]PowerRef, error)
        +Get(PowerRef) error
    }

    LocalClient ..|> CloudClient
    CloudClient --> PowerRef
