classDiagram
    note for CloudClient "List 返回全部精确 PowerRef；Skill Get 写缓存；GetMCP 直接返回互斥的 stdio/http 定义"
    class CloudClient {
        <<interface>>
        +List() ([]PowerRef, error)
        +Get(PowerRef) error
        +GetMCP(PowerRef) (MCPServer, error)
    }
    class MCPServer {
        +Transport MCPTransport
        +Command string
        +Args []string
        +URL string
        +Validate() error
    }
    class LocalClient {
        +List() ([]PowerRef, error)
        +Get(PowerRef) error
        +GetMCP(PowerRef) (MCPServer, error)
    }
    LocalClient ..|> CloudClient
    CloudClient --> MCPServer : direct, no cache/staging
