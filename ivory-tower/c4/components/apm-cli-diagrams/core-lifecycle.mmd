classDiagram
    class SearchLifecycle {
        <<interface>>
        +Search(Context, Flags) SearchResult
    }
    class ListLifecycle {
        <<interface>>
        +List(Context, Flags) ListResult
    }
    class InstallLifecycle {
        <<interface>>
        +Install(Context, Flags) InstallResult
    }
    class UninstallLifecycle {
        <<interface>>
        +Uninstall(Context, Flags) UninstallResult
    }
    class FixLifecycle {
        <<interface>>
        +Fix(Context) error
    }
    class ValidateLifecycle {
        <<interface>>
        +Validate(Context, Flags, args) ValidateResult
    }
    class SubmitLifecycle {
        <<interface>>
        +Submit(Context, Flags, args) SubmitResult
    }
    class SubmissionQueryLifecycle {
        <<interface>>
        +Get(Context, id) SubmissionQueryResult
        +List(Context, Flags) SubmissionQueryResult
    }

    class searchService
    class listService
    class installService
    class uninstallService
    class fixService
    class validateService
    class submitService
    class submissionQueryService
    searchService ..|> SearchLifecycle
    listService ..|> ListLifecycle
    installService ..|> InstallLifecycle
    uninstallService ..|> UninstallLifecycle
    fixService ..|> FixLifecycle
    validateService ..|> ValidateLifecycle
    submitService ..|> SubmitLifecycle
    submissionQueryService ..|> SubmissionQueryLifecycle

    class Inspector {
        <<interface>>
        +Inspect(Context) InspectionResult
    }
    class Recoverer {
        <<interface>>
        +Recover(Context) RecoveryResult
    }
    class Locker {
        <<interface>>
        +Acquire() Unlock
    }
    class CatalogManager {
        <<interface>>
        +Snapshot(Context) (CatalogSnapshot, SyncStatus, error)
        +SnapshotLocked(Context) (CatalogSnapshot, SyncStatus, error)
    }
    class CatalogSnapshot {
        +List(PowerType) []CatalogEntry
        +Resolve(PowerRef) CatalogEntry
        +Metadata(PowerRef) CatalogEntry
    }
    class CatalogEntry {
        +Ref PowerRef
        +ContentType string
        +ContentSize int64
        +ContentMD5 string
        +Tags []string
    }
    class SyncStatus {
        +Updated bool
        +Stale bool
        +Cause error
    }
    CatalogManager --> CatalogSnapshot : returns immutable value
    CatalogManager --> SyncStatus
    CatalogSnapshot --> CatalogEntry : returns clones
    note for CatalogManager "Snapshot 自行短时获取非阻塞 apm.lock；SnapshotLocked 仅供已持锁 Install。Provider/update 失败可返回一次 stale 状态，锁/取消/本地安全失败不降级（ADR-021）"

    searchService --> Inspector : Inspect only
    searchService --> CatalogManager : Snapshot exactly once
    searchService --> CatalogSnapshot : local filter and latest per series
    listService --> Inspector : Inspect only
    listService --> CatalogManager : Cloud mode Snapshot once
    listService --> CatalogSnapshot : local type filter
    note for listService "list --installed 不调用 CatalogManager 或 Cloud；只 RefreshInstalled 与读取 manifest"

    fixService --> Locker : one full interval
    fixService --> Recoverer : Recover exactly once
    note for fixService "零 Catalog/Cloud 调用；不渲染业务 stdout"

    installService --> Locker : Acquire before Recover
    installService --> Recoverer : Recover inside lock
    installService --> CatalogManager : SnapshotLocked at most once
    installService --> CatalogSnapshot : resolve one exact CatalogEntry
    note for installService "显式精确 Plugin 的全部 manifest 命中可在 SnapshotLocked 前 unchanged 早退；其它路径把同一 entry 透传到内容边界"

    class PowerCache {
        <<interface>>
        +PrepareSkill(Context, CatalogEntry) stagingRoot
        +PrepareAgent(Context, CatalogEntry) stagingRoot
    }
    class PluginResourceManager {
        <<interface>>
        +Ensure(Context, CatalogEntry) Artifact
        +Lookup(PowerRef) Artifact
        +StageFilesystem(PowerRef) stagingRoot
    }
    class CloudClient {
        <<interface>>
        +CatalogVersion(Context) CatalogVersion
        +DownloadCatalog(Context, destination) error
        +DownloadSkill(Context, CatalogEntry, destination) error
        +DownloadAgent(Context, CatalogEntry, destination) error
        +GetMCP(Context, CatalogEntry) MCPServer
        +DownloadPlugin(Context, CatalogEntry, destination) error
        +Submit(Context, SubmissionRequest) SubmissionResult
        +GetSubmission(Context, id) Submission
        +ListSubmissions(Context, Query) SubmissionList
    }
    installService --> PowerCache : Skill or Agent target entry
    installService --> PluginResourceManager : Plugin target entry; previous by Ref
    installService --> CloudClient : MCP target and previous definitions by entry

    class AdapterRegistry {
        <<interface>>
        +RefreshInstalled() AgentSnapshot
        +ResolveSkill(AgentID) SkillAdapter
        +ResolveAgent(AgentID) AgentAdapter
        +ResolveMCP(AgentID) MCPAdapter
        +ResolvePlugin(AgentID) PluginAdapter
    }
    class ConfigRepository {
        <<interface>>
        +List(AgentID) PowerGroups
        +Find(AgentID, PowerType, name) (PowerRef, found)
        +Set(AgentID, PowerRef) error
        +Remove(AgentID, PowerType, name) error
    }
    class TransactionManager {
        <<interface>>
        +InstallSkill(Context, Request) error
        +InstallAgent(Context, Request) error
        +InstallMCP(Context, Request) error
        +InstallPlugin(Context, Request) error
        +UninstallSkill(Context, Request) UninstallResult
        +UninstallAgent(Context, Request) UninstallResult
        +UninstallMCP(Context, Request) UninstallResult
        +UninstallPlugin(Context, Request) UninstallResult
    }
    TransactionManager --|> Inspector
    TransactionManager --|> Recoverer
    installService --> AdapterRegistry : refresh and resolve
    installService --> ConfigRepository : manifest facts
    installService --> TransactionManager : serial recoverable changes

    class PluginArtifactLookup {
        <<read-only interface>>
        +Lookup(PowerRef) Artifact
    }
    uninstallService --> Locker : one full interval
    uninstallService --> Recoverer : Recover inside lock
    uninstallService --> AdapterRegistry : local refresh and adapters
    uninstallService --> ConfigRepository : manifest authority
    uninstallService --> PluginArtifactLookup : local Plugin artifact only
    uninstallService --> TransactionManager : local serial uninstall
    note for uninstallService "构造和执行均无 CatalogManager/Cloud。MCP 只用 manifest Ref 与 Agent CLI；definition-free journal 的 recovery 永远收敛 absent，永不 Add"

    class SubmissionPackage {
        <<internal/submission>>
        +Validate(Context, Request) Validation
        +Prepare(Context, Request) Content
    }
    validateService --> SubmissionPackage : Validate offline
    submitService --> SubmissionPackage : Prepare authoritative content
    submitService --> CloudClient : authenticated Submit
    submissionQueryService --> CloudClient : authenticated get/list
    note for SubmissionQueryLifecycle "Submission 认证请求独立于匿名 catalog，失败不使用 stale snapshot"
