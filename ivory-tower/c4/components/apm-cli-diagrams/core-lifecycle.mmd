classDiagram
    note for SearchLifecycle "Search factory 先构造并校验 provider；Search 无锁 Inspect journal，Warn/Debug 后调用 Cloud List 并返回结构化结果"
    class SearchLifecycle {
        <<interface>>
        +Search(Context, Flags) (SearchResult, error)
    }
    class SearchResult {
        +Powers []PowerRef
    }
    class searchService {
        +Search(...)
    }

    note for ListLifecycle "默认/installed 共用先构造并校验 provider 的 factory，且都无锁 Inspect；installed 进入查询后不访问 Cloud，只做 Refresh 与 best-effort Config reads"
    class ListLifecycle {
        <<interface>>
        +List(Context, Flags) (ListResult, error)
    }
    class ListResult {
        +Powers []ListedPower
    }
    class PartialListError {
        +Failures []AgentFailure
    }
    class listService {
        +List(...)
    }

    note for FixLifecycle "Fix：一次锁内恰好 Recover 一次；同步 Warn/Debug 后 Release；无 stdout 结果"
    class FixLifecycle {
        <<interface>>
        +Fix(Context) error
    }
    class fixService {
        +Fix(Context) error
    }

    note for InstallLifecycle "Install 专属端口；显式规范 Plugin ref 可在全部 manifest 精确命中时先于 Cloud 返回；只有成功 Release 的 batch error 可保留结果"
    class InstallLifecycle {
        <<interface>>
        +Install(Context, Flags) (InstallResult, error)
    }
    class InstallItem {
        +Agent AgentID
        +Power PowerRef
        +Outcome InstallOutcome
    }
    class InstallResult {
        +Items []InstallItem
    }
    class InstallBatchError {
        +Agent AgentID
        +Err error
    }
    class installService {
        +Install(...)
    }

    note for UninstallLifecycle "Uninstall 专属端口；只有成功 Release 的 batch error 可保留结果"
    class UninstallLifecycle {
        <<interface>>
        +Uninstall(Context, Flags) (UninstallResult, error)
    }
    class UninstallItem {
        +Agent AgentID
        +Power *PowerRef
        +Outcome UninstallOutcome
    }
    class UninstallResult {
        +Items []UninstallItem
    }
    class UninstallBatchError {
        +Agent AgentID
        +Err error
    }
    note for uninstallService "Acquire → Recover/Warn → Refresh → per-Agent Config/Resolve/Transaction → successful Release；Warn 同步且不负责 CLI 渲染"
    class uninstallService {
        +Uninstall(...)
    }

    class AdapterRegistry {
        <<interface>>
        +ResolveSkill(AgentID) (Adapter, error)
        +ResolveAgent(AgentID) (AgentAdapter, error)
        +ResolveMCP(AgentID) (MCPAdapter, error)
        +ResolvePlugin(AgentID) (PluginAdapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }
    note for Adapter "不定义 Uninstall 方法；Transaction 使用 TargetPath 管理 quarantine"
    class Adapter {
        <<interface>>
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot) (AdapterInstallResult, error)
    }
    note for AgentAdapter "仅 Bibit；单文件 agent.yaml 原样字节发布到 agents/<agent.id>/agent.yaml（ADR-015）"
    class AgentAdapter {
        <<interface>>
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, staging) (AgentInstallResult, error)
    }
    class AgentInstallResult {
        +Published bool
    }
    class AdapterInstallResult {
        +Published bool
    }
    class AgentSnapshot {
        +Agents []AgentID
        +Contains(AgentID) bool
        +Ordered() []AgentID
    }
    class ConfigRepository {
        <<interface>>
        +List(AgentID) (PowerGroups, error)
        +Find(AgentID, PowerType, name) (PowerRef, bool, error)
        +Set(AgentID, PowerRef) error
        +Remove(AgentID, PowerType, name) error
    }
    note for Inspector "只读读取并统一校验 journal；不恢复、不写状态"
    class Inspector {
        <<interface>>
        +Inspect(Context) (InspectionResult, error)
    }
    note for Recoverer "在调用方持锁时收敛唯一 journal"
    class Recoverer {
        <<interface>>
        +Recover(Context) (RecoveryResult, error)
    }
    note for TransactionManager "组合 Inspector 与 Recoverer，并提供 Skill/Agent/MCP/Plugin 变更事务；非法 journal 保留"
    class TransactionManager {
        <<interface>>
        +InstallSkill(Context, SkillInstallRequest) error
        +InstallAgent(Context, AgentInstallRequest) error
        +InstallMCP(Context, MCPInstallRequest) error
        +InstallPlugin(Context, PluginInstallRequest) error
        +UninstallSkill(Context, SkillUninstallRequest) (TransactionUninstallResult, error)
        +UninstallAgent(Context, AgentUninstallRequest) (TransactionUninstallResult, error)
        +UninstallMCP(Context, MCPUninstallRequest) (TransactionUninstallResult, error)
        +UninstallPlugin(Context, PluginUninstallRequest) (TransactionUninstallResult, error)
    }
    class TransactionUninstallResult {
        +TargetMissing bool
    }
    class InspectionResult {
        +Active bool
        +TransactionID string
        +Operation Operation
        +Agent AgentID
        +Power PowerRef
        +OriginalPhase Phase
    }
    class Locker {
        <<interface>>
        +Acquire() (Unlock, error)
    }
    class PowerCache {
        <<interface>>
        +PrepareSkill(Context, PowerRef) (stagingRoot string, error)
        +PrepareAgent(Context, PowerRef) (stagingRoot string, error)
    }
    class PluginResourceManager {
        <<interface>>
        +Ensure(Context, PowerRef) (Artifact, error)
        +Lookup(PowerRef) (Artifact, error)
        +StageFilesystem(PowerRef) (stagingRoot string, error)
    }
    class PluginArtifact {
        +Power PowerRef
        +Root string
        +PluginPath string
        +CodexMarketplaceSource string
        +ClaudeMarketplaceSource string
        +MarketplaceFor(AgentID) (Marketplace, error)
    }
    class CloudClient {
        <<interface>>
        +List(Context) ([]PowerRef, error)
        +Resolve(Context, PowerRef) (PowerRef, error)
        +DownloadSkill(Context, PowerRef, destination) error
        +DownloadAgent(Context, PowerRef, destination) error
        +GetMCP(Context, PowerRef) (MCPServer, error)
        +DownloadPlugin(Context, PowerRef, destination) error
    }
    class VersionSelector {
        <<interface>>
        +Select(candidates []string, requested string) (string, error)
    }

    searchService ..|> SearchLifecycle
    searchService --> SearchResult : returns
    searchService --> Inspector : Inspect only
    searchService --> CloudClient : List

    listService ..|> ListLifecycle
    listService --> ListResult : returns
    listService --> PartialListError : all-mode Config failures
    listService --> AdapterRegistry : installed only
    listService --> ConfigRepository : installed only
    listService --> Inspector : Inspect only, both modes
    listService --> CloudClient : List, Cloud mode

    fixService ..|> FixLifecycle
    fixService --> Locker : one lock interval
    fixService --> Recoverer : Recover exactly once

    installService ..|> InstallLifecycle
    installService --> InstallResult : returns
    installService --> InstallBatchError : successful Release only
    installService --> Locker : one lock interval
    installService --> TransactionManager : Recover / InstallSkill / InstallAgent / InstallMCP / InstallPlugin
    installService --> CloudClient : List / Resolve / GetMCP; Cache and Plugin Resource consume sources
    installService --> PowerCache : Skill PrepareSkill / Agent PrepareAgent only
    installService --> PluginResourceManager : Plugin Ensure / Lookup / StageFilesystem
    installService --> AdapterRegistry : Refresh / ResolveSkill / ResolveAgent / ResolveMCP / ResolvePlugin
    installService --> ConfigRepository : Find
    installService --> VersionSelector : resolve version

    uninstallService ..|> UninstallLifecycle
    uninstallService --> UninstallResult : returns after Release
    uninstallService --> UninstallBatchError : successful Release only
    uninstallService --> Locker : one lock interval
    uninstallService --> TransactionManager : Recover / UninstallSkill / UninstallAgent / UninstallMCP / UninstallPlugin
    uninstallService --> AdapterRegistry : Refresh / ResolveSkill / ResolveAgent / ResolveMCP / ResolvePlugin
    uninstallService --> ConfigRepository : List
    uninstallService --> CloudClient : MCP GetMCP only when present
    uninstallService --> PluginResourceManager : Plugin Lookup only, never Cloud

    AdapterRegistry --> Adapter : resolves
    AdapterRegistry --> AgentAdapter : resolves
    AdapterRegistry --> AgentSnapshot : returns
    Adapter --> AdapterInstallResult : Install returns
    AgentAdapter --> AgentInstallResult : Install returns
    TransactionManager --> Adapter : TargetPath / Install
    TransactionManager --> AgentAdapter : TargetPath / Install
    TransactionManager --> TransactionUninstallResult : returns
    TransactionManager --|> Inspector : embeds
    TransactionManager --|> Recoverer : embeds
    Inspector --> InspectionResult : returns
    TransactionManager --> ConfigRepository : Set / Remove
    PluginResourceManager --> PluginArtifact : returns canonical-derived immutable shared artifact, caller uses MarketplaceFor (ADR-017)
