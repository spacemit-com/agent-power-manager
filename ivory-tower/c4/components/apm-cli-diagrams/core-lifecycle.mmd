classDiagram
    note for Lifecycle "生命周期用例接口：CLI 的四个动词一一对应"
    class Lifecycle {
        <<interface>>
        +Search(Flags) ([]PowerRef, error)
        +Install(Flags) (Result, error)
        +Uninstall(Flags) (Result, error)
        +List(Flags) (ListResult, error)
    }

    note for lifecycleService "四个命令先取全局锁并调用集中 TransactionManager 恢复；本地 Power 操作刷新 Agent 快照；业务预检后把单 Agent 文件与清单一致性交给 transaction"
    class lifecycleService {
        +Search(...)
        +Install(...)
        +Uninstall(...)
        +List(...)
    }

    note for AdapterRegistry "刷新当前命令的已支持且已安装 Agent 快照，并按 Agent × Power 类别解析适配实现"
    class AdapterRegistry {
        <<interface>>
        +Resolve(AgentID, PowerType) (Adapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }

    class Adapter {
        <<interface>>
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot) (InstallResult, error)
    }

    class AgentSnapshot {
        +Agents []AgentID
        +Contains(AgentID) bool
        +Ordered() []AgentID
    }

    note for ConfigRepository "无状态封装各 Agent 清单的查询和原子读改写；调用时全局锁已由 lifecycle 持有"
    class ConfigRepository {
        <<interface>>
        +List(AgentID) (PowerGroups, error)
        +Find(AgentID, PowerType, name) (PowerRef, bool, error)
        +Set(AgentID, PowerRef) error
        +Remove(AgentID, PowerType, name) error
    }

    note for TransactionManager "集中封装唯一活动 journal、同盘 backup/quarantine、Adapter 发布结果、清单写入、回滚和跨命令恢复"
    class TransactionManager {
        <<interface>>
        +Recover(Context) (RecoveryResult, error)
        +Install(Context, InstallRequest) error
        +Uninstall(Context, UninstallRequest) error
    }

    note for Locker "四个生命周期命令从启动预检到结束全程持有的全局 APM 文件锁"
    class Locker {
        <<interface>>
        +Acquire() (Unlock, error)
    }

    note for PowerCache "将版本已确定的 PowerRef 从版本化缓存物化到干净 staging"
    class PowerCache {
        <<interface>>
        +Fetch(PowerRef) (Content, error)
    }

    note for CloudClient "List 返回带版本的全部 PowerRef；Get 将版本已确定的 PowerRef 原子写入缓存"
    class CloudClient {
        <<interface>>
        +List() ([]PowerRef, error)
        +Get(PowerRef) error
    }

    lifecycleService ..|> Lifecycle
    lifecycleService --> AdapterRegistry
    AdapterRegistry --> Adapter : resolves
    AdapterRegistry --> AgentSnapshot : returns
    lifecycleService --> ConfigRepository : List/Find
    lifecycleService --> TransactionManager
    TransactionManager --> Adapter : TargetPath/Install
    TransactionManager --> ConfigRepository : Set/Remove
    lifecycleService --> Locker
    lifecycleService --> PowerCache
    lifecycleService --> CloudClient
