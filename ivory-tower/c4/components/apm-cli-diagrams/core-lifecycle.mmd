classDiagram
    note for SearchLifecycle "Search：Recover 后 Release，再查询 Cloud；返回结构化结果，不打印"
    class SearchLifecycle {
        <<interface>>
        +Search(Context, Flags) (SearchResult, error)
    }
    class SearchResult {
        +Powers []PowerRef
    }
    class searchService {
        +Search(...)
    }

    note for ListLifecycle "List：Cloud 无锁；installed 成功 Release 后才返回可渲染结果"
    class ListLifecycle {
        <<interface>>
        +List(Context, Flags) (ListResult, error)
    }
    class ListResult {
        +Powers []ListedPower
    }
    class PartialListError {
        +Failures []AgentFailure
    }
    class listService {
        +List(...)
    }

    note for InstallLifecycle "Install 专属端口；只有成功 Release 的 batch error 可保留结果"
    class InstallLifecycle {
        <<interface>>
        +Install(Context, Flags) (InstallResult, error)
    }
    class InstallItem {
        +Agent AgentID
        +Power PowerRef
        +Outcome InstallOutcome
    }
    class InstallResult {
        +Items []InstallItem
    }
    class InstallBatchError {
        +Agent AgentID
        +Err error
    }
    note for installService "Acquire → Recover/Warn → Refresh/target validation → Cloud resolve → serial work → successful Release；不负责 CLI 打印"
    class installService {
        +Install(...)
    }

    class AdapterRegistry {
        <<interface>>
        +Resolve(AgentID, PowerType) (Adapter, error)
        +RefreshInstalled() (AgentSnapshot, error)
    }
    class Adapter {
        <<interface>>
        +TargetPath(PowerRef) (string, error)
        +Install(PowerRef, stagingRoot) (InstallResult, error)
    }
    class AgentSnapshot {
        +Agents []AgentID
        +Contains(AgentID) bool
        +Ordered() []AgentID
    }
    class ConfigRepository {
        <<interface>>
        +List(AgentID) (PowerGroups, error)
        +Find(AgentID, PowerType, name) (PowerRef, bool, error)
        +Set(AgentID, PowerRef) error
        +Remove(AgentID, PowerType, name) error
    }
    note for TransactionManager "集中 journal；Install 陈旧 target 缺失时 Remove 单条清单、清理 staging、ErrStaleManifest 并中止"
    class TransactionManager {
        <<interface>>
        +Recover(Context) (RecoveryResult, error)
        +Install(Context, InstallRequest) error
        +Uninstall(Context, UninstallRequest) error
    }
    class Locker {
        <<interface>>
        +Acquire() (Unlock, error)
    }
    class PowerCache {
        <<interface>>
        +Fetch(PowerRef) (stagingRoot string, error)
    }
    class CloudClient {
        <<interface>>
        +List() ([]PowerRef, error)
        +Get(PowerRef) error
    }
    class VersionSelector {
        <<interface>>
        +Select(candidates []string, requested string) (string, error)
    }

    searchService ..|> SearchLifecycle
    searchService --> TransactionManager
    searchService --> Locker
    searchService --> CloudClient
    listService ..|> ListLifecycle
    listService --> AdapterRegistry : installed only
    listService --> ConfigRepository : installed only
    listService --> TransactionManager : installed only
    listService --> Locker : installed only
    listService --> CloudClient : Cloud only
    installService ..|> InstallLifecycle
    installService --> InstallResult : returns
    installService --> InstallBatchError : successful Release only
    installService --> Locker : 1 lock interval
    installService --> TransactionManager : Recover/Install
    installService --> CloudClient : List/Get
    installService --> PowerCache : Fetch
    installService --> AdapterRegistry : Refresh/Resolve
    installService --> ConfigRepository : Find
    installService --> VersionSelector : resolve version
    AdapterRegistry --> Adapter : resolves
    AdapterRegistry --> AgentSnapshot : returns
    TransactionManager --> Adapter : TargetPath/Install
    TransactionManager --> ConfigRepository : Set/Remove
