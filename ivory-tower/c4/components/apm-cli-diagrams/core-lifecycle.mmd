classDiagram
    note for Lifecycle "生命周期用例接口：CLI 的四个动词一一对应"
    class Lifecycle {
        <<interface>>
        +Search(Flags) ([]PowerRef, error)
        +Install(Flags) (Result, error)
        +Uninstall(Flags) (Result, error)
        +List(Flags) (ListResult, error)
    }

    note for lifecycleService "四个命令先取全局锁并修复唯一活动 journal；install/uninstall 以原子文件操作为提交点，--agent=all 串行且失败即停"
    class lifecycleService {
        +Search(...)
        +Install(...)
        +Uninstall(...)
        +List(...)
    }

    note for AdapterRegistry "按 Agent × Power 类别解析适配实现"
    class AdapterRegistry {
        <<interface>>
        +Resolve(AgentID, PowerType) (Adapter, error)
    }

    note for ConfigStore "各 Agent 独立的已安装 Power 清单读写"
    class ConfigStore {
        <<interface>>
        +Read(AgentID) (Manifest, error)
        +Write(AgentID, Manifest) error
    }

    class JournalStore {
        <<interface>>
        +Inspect() (Journal, error)
        +Write(Journal) error
        +Delete() error
    }

    note for Locker "四个生命周期命令从启动预检到结束全程持有的全局 APM 文件锁"
    class Locker {
        <<interface>>
        +Acquire() (Unlock, error)
    }

    note for PowerCache "下载内容的本地缓存"
    class PowerCache {
        <<interface>>
        +Fetch(PowerRef) (Content, error)
    }

    note for CloudClient "云端 Power 资源的 list/get"
    class CloudClient {
        <<interface>>
        +List(Query) ([]PowerRef, error)
        +Get(PowerRef) (PowerMeta, error)
    }

    lifecycleService ..|> Lifecycle
    lifecycleService --> AdapterRegistry
    lifecycleService --> ConfigStore
    lifecycleService --> JournalStore
    lifecycleService --> Locker
    lifecycleService --> PowerCache
    lifecycleService --> CloudClient
